{
  "name": "sentry-agent-extension",
  "version": "1.0.0",
  "description": "On-Device Privacy-Preserving Browser Agent for SIH26171 (ISRO)",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "node --test ../testbed/automated-tests/privacy.test.mjs",
    "test:e2e": "node --test ../testbed/automated-tests/e2e-plan.test.mjs",
    "test:all": "node --test ../testbed/automated-tests/privacy.test.mjs ../testbed/automated-tests/e2e-plan.test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  }
}
